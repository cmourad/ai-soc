# Sensor-side noise suppression. This directory is mounted read-only at
# /etc/aisoc and the file is loaded via --set threshold-file= in compose.yml
# (the stock suricata.yaml ships that key commented out). The whole directory
# is mounted, not the file: editing a bind-mounted file replaces its inode and
# the container keeps reading the old one until it is recreated.
#
# Suppressed here rather than filtered in the agent so the noise never reaches
# eve.json at all — these two signatures alone were 10,791 of the last 10,791
# alerts (~936 MB of eve.json) and every one of them is a WebRTC/video-call
# STUN handshake with no security value. Leaving them in makes severity-3
# triage cost 2.1x more GPU-hours than wall clock, which is why the agent has
# had AISOC_MAX_SEVERITY=2 and therefore triaged nothing.
#
# Re-check after adding a rule pack: `grep -c '"severity":3' eve.json`.

# comments must be on their own line — a trailing one is fed to the pcre parser
# ET INFO STUN Binding Request
suppress gen_id 1, sig_id 2016149
# ET INFO STUN Binding Response
suppress gen_id 1, sig_id 2016150

# Decoder noise on the aisoc0 tunnel: GRO/GSO hands Suricata segments larger
# than the link MTU, which it reports as truncated. 328 of the tunnel sensor's
# first 333 alerts. Artifacts of how we capture, not of what crossed the wire.
# SURICATA IPv4 truncated packet
suppress gen_id 1, sig_id 2200003
# SURICATA IPv6 truncated packet
suppress gen_id 1, sig_id 2200013
# SURICATA AF-PACKET truncated packet
suppress gen_id 1, sig_id 2200122
