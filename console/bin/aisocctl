#!/usr/bin/env node
import { createConnection } from "node:net";

const SOCKET = process.env.AISOC_CONSOLE_CONTROL_SOCKET ?? "/run/aisoc-console/control.sock";
const MAX_RESPONSE = 2 * 1024 * 1024;

const HELP = `aisocctl — audited AI SOC operations

Overview:
  aisocctl status

Sensors:
  aisocctl sensors status
  aisocctl sensors restart --down [--confirm]
  aisocctl sensors restart --all [--confirm]

Pi-hole:
  aisocctl pihole status
  aisocctl pihole restart [--confirm]

DNS:
  aisocctl dns status
  aisocctl dns top [--clients] [--limit N]
  aisocctl dns recent [--limit N] [--blocked]
  aisocctl dns resolver [--apply [--confirm]]

Audit:
  aisocctl audit [--limit N]

Incidents:
  aisocctl incidents list [filters]
  aisocctl incidents assign --to NAME [filters] [--confirm]
  aisocctl incidents close [filters] [--confirm]

Filters:
  --status active|open|investigating|contained|closed
  --severity 1,2,3,4
  --older-than 30m|12h|7d
  --refs INC-0001,INC-0002
  --all                         match every incident

Mutations are previews unless --confirm is supplied.
--json prints the raw control response instead of a table.

Examples:
  aisocctl status
  aisocctl sensors restart --down --confirm
  aisocctl dns status
  aisocctl dns top --clients --limit 5
  aisocctl dns recent --blocked --limit 20
  aisocctl dns resolver --apply --confirm
  aisocctl audit --limit 40
  aisocctl incidents close --severity 3,4 --older-than 24h --confirm`;

function fail(message) {
  console.error(`aisocctl: ${message}`);
  process.exitCode = 2;
}

function option(args, name) {
  const index = args.indexOf(name);
  if (index === -1) return undefined;
  const value = args[index + 1];
  if (!value || value.startsWith("--")) throw new Error(`${name} requires a value`);
  return value;
}

function validateOptions(args, valueOptions, flagOptions, start = 2) {
  const seen = new Set();
  for (let index = start; index < args.length; index += 1) {
    const name = args[index];
    if (valueOptions.has(name)) {
      if (seen.has(name)) throw new Error(`${name} may only be supplied once`);
      seen.add(name);
      const value = args[index + 1];
      if (!value || value.startsWith("--")) throw new Error(`${name} requires a value`);
      index += 1;
    } else if (flagOptions.has(name)) {
      if (seen.has(name)) throw new Error(`${name} may only be supplied once`);
      seen.add(name);
    } else {
      throw new Error(`unknown option: ${name}`);
    }
  }
}

function limitOption(args, fallback, max) {
  const raw = option(args, "--limit");
  if (raw === undefined) return fallback;
  const value = Number(raw);
  if (!Number.isInteger(value) || value < 1 || value > max) {
    throw new Error(`--limit must be an integer between 1 and ${max}`);
  }
  return value;
}

function duration(value) {
  const match = /^(\d+)(m|h|d)$/.exec(value);
  if (!match) throw new Error("--older-than must look like 30m, 12h, or 7d");
  const count = Number(match[1]);
  const unit = { m: 60_000, h: 3_600_000, d: 86_400_000 }[match[2]];
  return count * unit;
}

function incidentFilter(args) {
  const all = args.includes("--all");
  const status = option(args, "--status");
  if (all && status) throw new Error("--all and --status cannot be combined");
  if (status && !["active", "open", "investigating", "contained", "closed"].includes(status)) {
    throw new Error("invalid --status");
  }
  const severity = option(args, "--severity");
  const severities = severity?.split(",").map(Number);
  if (severities?.some((value) => !Number.isInteger(value) || value < 1 || value > 4)) {
    throw new Error("--severity must be a comma-separated subset of 1,2,3,4");
  }
  const olderThan = option(args, "--older-than");
  const refs = option(args, "--refs")
    ?.split(",")
    .map((value) => value.trim().toUpperCase());
  if (refs?.some((ref) => !/^INC-\d+$/.test(ref))) throw new Error("invalid incident reference");
  return {
    ...(all ? {} : { status: status ?? "active" }),
    ...(severities ? { severities } : {}),
    ...(olderThan ? { olderThanMs: duration(olderThan) } : {}),
    ...(refs ? { refs } : {}),
  };
}

function request(payload) {
  return new Promise((resolve, reject) => {
    const socket = createConnection(SOCKET);
    let buffer = "";
    const settle = (error, value) => {
      socket.destroy();
      if (error) reject(error);
      else resolve(value);
    };
    socket.setEncoding("utf8");
    socket.setTimeout(240_000, () => settle(new Error("console control timed out")));
    socket.on("connect", () => socket.write(`${JSON.stringify(payload)}\n`));
    socket.on("data", (chunk) => {
      buffer += chunk;
      if (buffer.length > MAX_RESPONSE) {
        settle(new Error("console response was too large"));
        return;
      }
      const newline = buffer.indexOf("\n");
      if (newline === -1) return;
      try {
        settle(null, JSON.parse(buffer.slice(0, newline)));
      } catch {
        settle(new Error("console returned invalid JSON"));
      }
    });
    socket.on("error", (error) => settle(error));
    socket.on("end", () => {
      if (!buffer.includes("\n")) settle(new Error("console closed without a reply"));
    });
  });
}

const count = (value) => (value ?? 0).toLocaleString("en-US");

function percent(part, whole) {
  if (!whole) return "0.0%";
  return `${((part / whole) * 100).toFixed(1)}%`;
}

function elapsed(seconds) {
  const days = Math.floor(seconds / 86_400);
  const hours = Math.floor((seconds % 86_400) / 3_600);
  const minutes = Math.floor((seconds % 3_600) / 60);
  if (days) return `${days}d ${hours}h`;
  if (hours) return `${hours}h ${minutes}m`;
  return `${minutes}m`;
}

function printSensors(sensors) {
  if (!sensors?.length) {
    console.log("No live sensor paths are configured.");
    return;
  }
  console.log("STATE  SENSOR                         DETAIL");
  for (const sensor of sensors) {
    console.log(`${sensor.ok ? "OK  " : "DOWN"}   ${sensor.label.padEnd(30)} ${sensor.detail}`);
  }
}

function printIncidents(incidents) {
  if (!incidents?.length) {
    console.log("No incidents matched.");
    return;
  }
  console.log("REF       SEV  STATUS          SCORE  ASSIGNEE        TITLE");
  for (const incident of incidents) {
    const title = incident.title.length > 70 ? `${incident.title.slice(0, 67)}...` : incident.title;
    console.log(
      `${incident.ref.padEnd(9)} ${String(incident.severity).padEnd(4)} ${incident.status.padEnd(15)} ${String(incident.score).padEnd(6)} ${(incident.assignee ?? "-").padEnd(15)} ${title}`,
    );
  }
}

function printPihole(pihole) {
  console.log("STATE    HEALTH     DETAIL");
  if (!pihole?.installed) {
    console.log("MISSING  -          No Pi-hole container exists.");
    return;
  }
  const state = pihole.running ? "RUNNING" : pihole.state.toUpperCase();
  console.log(`${state.padEnd(8)} ${(pihole.health || "-").padEnd(10)} ${pihole.status || "-"}`);
}

function printStats(stats) {
  console.log(
    `Events/s ${stats.eventsPerSecond}   Total ${count(stats.totalEvents)}   Open alerts ${count(stats.openAlerts)}   Needs human ${count(stats.needsHuman)}   Queue ${stats.queueDepth}/${stats.queueCapacity}`,
  );
  console.log(
    `Incidents ${count(stats.openSecurityIncidents)} open   Detections ${count(stats.detectionHits)} hits (${count(stats.malicious)} malicious, ${count(stats.suspicious)} suspicious)   Actions ${count(stats.pendingActions)} pending / ${count(stats.appliedActions)} applied`,
  );
  console.log(
    `Assets ${count(stats.assetsOnline)}/${count(stats.assetsTotal)} online, ${count(stats.assetsIsolated)} isolated, ${count(stats.atRiskAssets)} at risk   Quarantine ${count(stats.quarantined)}`,
  );
  console.log(
    `Autonomy ${stats.autonomy}   Ingest ${stats.ingestSource}${stats.paused ? " (paused)" : ""}   VPN ${stats.vpnStatus}${stats.vpnCountry ? ` (${stats.vpnCountry})` : ""}   Uptime ${elapsed(stats.uptimeSeconds)}   Engine ${stats.engineVersion}`,
  );
}

function printDnsTotals(dns) {
  if (!dns.available) {
    console.log(`Resolver unavailable: ${dns.error ?? "unknown reason"}`);
    return;
  }
  const { queries, blocked, cached, forwarded, clients } = dns.totals;
  console.log(
    `Window ${dns.windowHours}h   Queries ${count(queries)}   Blocked ${count(blocked)} (${percent(blocked, queries)})   Cached ${count(cached)}   Forwarded ${count(forwarded)}   Clients ${count(clients)}`,
  );
}

function printDnsTop(rows, heading) {
  if (!rows.length) {
    console.log(`No ${heading.toLowerCase()} recorded in the window.`);
    return;
  }
  console.log(`QUERIES   BLOCKED   ${heading.toUpperCase()}`);
  for (const row of rows) {
    console.log(`${count(row.queries).padEnd(9)} ${count(row.blocked).padEnd(9)} ${row.key}`);
  }
}

function printDnsRecent(queries) {
  if (!queries.length) {
    console.log("No queries matched.");
    return;
  }
  console.log("TIME      STATUS     CLIENT           TYPE   DOMAIN");
  for (const query of queries) {
    const time = query.at.slice(11, 19);
    const domain = query.domain.length > 60 ? `${query.domain.slice(0, 57)}...` : query.domain;
    console.log(
      `${time}  ${query.status.padEnd(10)} ${query.client.padEnd(16)} ${query.type.padEnd(6)} ${domain}`,
    );
  }
}

function printResolver(resolver) {
  const dns = resolver.dns?.length ? resolver.dns.join(", ") : "-";
  const domains = resolver.domains?.length ? resolver.domains.join(", ") : "-";
  const vpnDns = resolver.vpn?.dns?.length ? resolver.vpn.dns.join(", ") : "-";
  console.log(`Routed through Pi-hole: ${resolver.routed ? "yes" : "no"}`);
  console.log(`${resolver.interface}: dns ${dns}   domains ${domains}`);
  console.log(`${resolver.vpn?.interface ?? "vpn"}: dns ${vpnDns}   (must be empty to win the ~. route)`);
  console.log(`Pi-hole address: ${resolver.expected ?? "-"}`);
}

function printAudit(entries) {
  if (!entries.length) {
    console.log("No audit entries recorded.");
    return;
  }
  console.log("TIME                 OK   ACTOR                 ACTION                TARGET");
  for (const entry of entries) {
    console.log(
      `${entry.at.slice(0, 19).replace("T", " ")}  ${(entry.ok ? "ok" : "FAIL").padEnd(4)} ${entry.actor.padEnd(21)} ${entry.action.padEnd(21)} ${entry.target}`,
    );
    if (entry.detail) console.log(`                     ${entry.detail}`);
  }
}

function build(args) {
  if (args[0] === "status") {
    validateOptions(args, new Set(), new Set(), 1);
    return { payload: { command: "status" } };
  }
  if (args[0] === "sensors" && args[1] === "status") {
    validateOptions(args, new Set(), new Set());
    return { payload: { command: "sensors.status" } };
  }
  if (args[0] === "sensors" && args[1] === "restart") {
    validateOptions(args, new Set(), new Set(["--down", "--all", "--confirm"]));
    if (!args.includes("--down") && !args.includes("--all")) {
      throw new Error("sensor restart requires --down or --all");
    }
    if (args.includes("--down") && args.includes("--all")) {
      throw new Error("choose either --down or --all");
    }
    return {
      payload: {
        command: "sensors.restart",
        downOnly: !args.includes("--all"),
        confirm: args.includes("--confirm"),
      },
    };
  }
  if (args[0] === "pihole" && args[1] === "status") {
    validateOptions(args, new Set(), new Set());
    return { payload: { command: "pihole.status" } };
  }
  if (args[0] === "pihole" && args[1] === "restart") {
    validateOptions(args, new Set(), new Set(["--confirm"]));
    return { payload: { command: "pihole.restart", confirm: args.includes("--confirm") } };
  }
  if (args[0] === "dns" && args[1] === "status") {
    validateOptions(args, new Set(), new Set());
    return { payload: { command: "dns.summary" }, view: "dns.status" };
  }
  if (args[0] === "dns" && args[1] === "top") {
    validateOptions(args, new Set(["--limit"]), new Set(["--clients"]));
    return {
      payload: { command: "dns.summary" },
      view: args.includes("--clients") ? "dns.clients" : "dns.domains",
      limit: limitOption(args, 10, 10),
    };
  }
  if (args[0] === "dns" && args[1] === "recent") {
    validateOptions(args, new Set(["--limit"]), new Set(["--blocked"]));
    return {
      payload: { command: "dns.summary" },
      view: "dns.recent",
      limit: limitOption(args, 25, 100),
      blockedOnly: args.includes("--blocked"),
    };
  }
  if (args[0] === "dns" && args[1] === "resolver") {
    validateOptions(args, new Set(), new Set(["--apply", "--confirm"]));
    if (args.includes("--confirm") && !args.includes("--apply")) {
      throw new Error("--confirm only applies to --apply");
    }
    return {
      payload: {
        command: "dns.resolver",
        apply: args.includes("--apply"),
        confirm: args.includes("--confirm"),
      },
    };
  }
  if (args[0] === "audit") {
    validateOptions(args, new Set(["--limit"]), new Set(), 1);
    return { payload: { command: "audit.list", limit: limitOption(args, 20, 500) } };
  }
  if (args[0] === "incidents" && args[1] === "list") {
    validateOptions(
      args,
      new Set(["--status", "--severity", "--older-than", "--refs"]),
      new Set(["--all"]),
    );
    return { payload: { command: "incidents.list", filter: incidentFilter(args) } };
  }
  if (args[0] === "incidents" && args[1] === "assign") {
    validateOptions(
      args,
      new Set(["--status", "--severity", "--older-than", "--refs", "--to"]),
      new Set(["--all", "--confirm"]),
    );
    const assignee = option(args, "--to");
    if (!assignee) throw new Error("incident assignment requires --to NAME");
    return {
      payload: {
        command: "incidents.assign",
        filter: incidentFilter(args),
        assignee,
        confirm: args.includes("--confirm"),
      },
    };
  }
  if (args[0] === "incidents" && args[1] === "close") {
    validateOptions(
      args,
      new Set(["--status", "--severity", "--older-than", "--refs"]),
      new Set(["--all", "--confirm"]),
    );
    return {
      payload: {
        command: "incidents.close",
        filter: incidentFilter(args),
        confirm: args.includes("--confirm"),
      },
    };
  }
  throw new Error(`unknown command\n\n${HELP}`);
}

function renderDns(dns, plan) {
  if (plan.view === "dns.status") {
    printDnsTotals(dns);
    return;
  }
  if (!dns.available) {
    printDnsTotals(dns);
    return;
  }
  if (plan.view === "dns.domains") printDnsTop(dns.topDomains.slice(0, plan.limit), "Domain");
  if (plan.view === "dns.clients") printDnsTop(dns.topClients.slice(0, plan.limit), "Client");
  if (plan.view === "dns.recent") {
    const rows = plan.blockedOnly
      ? dns.recent.filter((query) => query.status === "blocked")
      : dns.recent;
    printDnsRecent(rows.slice(0, plan.limit));
  }
}

async function main() {
  const raw = process.argv.slice(2);
  if (raw.length === 0 || raw.includes("--help") || raw[0] === "help") {
    console.log(HELP);
    return;
  }
  const json = raw.includes("--json");
  const args = raw.filter((value) => value !== "--json");

  const plan = build(args);
  const response = await request(plan.payload);
  if (json) {
    console.log(JSON.stringify(response, null, 2));
    if (!response.ok) process.exitCode = 2;
    return;
  }
  if (!response.ok) throw new Error(response.error ?? "operation failed");

  if (response.stats) printStats(response.stats);
  if (response.sensors) printSensors(response.sensors);
  if (response.pihole !== undefined) printPihole(response.pihole);
  if (response.dns) renderDns(response.dns, plan);
  if (response.resolver) printResolver(response.resolver);
  if (response.audit) printAudit(response.audit);
  if (response.incidents) printIncidents(response.incidents);
  if (response.services?.length) console.log(`Sensors: ${response.services.join(", ")}`);
  if (response.output) console.log(response.output.trim());
  if (response.message) console.log(response.message);
  if (response.changed !== undefined) console.log(`Changed: ${response.changed}`);
}

main().catch((error) => fail(error instanceof Error ? error.message : String(error)));
