[Unit]
Description=AI SOC cluster-telemetry collector (Tetragon + k3s audit -> triage JSONL)
After=k3s.service network-online.target
Wants=network-online.target
# Tetragon's export is the stream that always exists on this node; the k3s
# audit log appears only once the API server is started with the audit drop-in.
# Either source alone is worth running for, so the condition names the one that
# makes the unit meaningful at all.
ConditionPathExists=/var/run/cilium/tetragon

[Service]
Type=simple
# Root, and deliberately so: it is the only process that reads the two
# root-only source files. It writes a minimised spool for the unprivileged
# console, which is what keeps the decision service out of this privilege.
# Runs from the root-owned copy, never the user-writable repo path.
ExecStart=/usr/bin/python3 /usr/local/libexec/aisoc/scripts/cluster_tail.py
Restart=always
RestartSec=5
StateDirectory=aisoc-host-events
# Read-only everywhere except its own state directory. The Tetragon export and
# the k3s audit log are inputs; this unit must never be able to alter the
# evidence it reads.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
